{
  "create_basic": {
    "description": "创建一个新的待办并返回成功摘要",
    "nl_input": "帮我添加一个叫写日报的待办，今晚 18:00 截止",
    "model_responses": [
      "{\"action\":\"create\"}",
      "{\"action\":\"create\",\"data\":{\"title\":\"写日报\",\"details\":null,\"due_at\":\"2025-12-04 18:00\",\"status\":\"pending\"},\"summary\":\"创建日报待办\"}"
    ],
    "api_responses": {
      "create": {
        "status": "ok",
        "data": {
          "id": 101,
          "title": "写日报",
          "details": null,
          "due_at": "2025-12-04 18:00",
          "status": "pending"
        }
      }
    },
    "expected_action": "create",
    "expected_summary": "创建日报待办"
  },
  "list_pending": {
    "description": "列出所有未完成的待办",
    "nl_input": "列出所有未完成的任务",
    "model_responses": [
      "{\"action\":\"list\"}",
      "{\"action\":\"list\",\"data\":{\"status\":\"pending\"},\"summary\":\"查看未完成待办\"}"
    ],
    "api_responses": {
      "list": {
        "status": "ok",
        "data": [
          {"id": 1, "title": "写日报", "details": null, "due_at": null, "status": "pending"},
          {"id": 2, "title": "同步周报", "details": null, "due_at": null, "status": "pending"}
        ]
      }
    },
    "expected_action": "list",
    "expected_summary": "查看未完成待办"
  },
  "delete_flow": {
    "description": "删除前需先筛选候选的多阶段流程",
    "nl_input": "删除名为测试条目的待办",
    "model_responses": [
      "{\"action\":\"delete\"}",
      "{\"action\":\"list\",\"data\":{\"keyword\":\"测试条目\"},\"summary\":\"筛选删除候选\"}",
      "{\"action\":\"delete\",\"data\":{\"id\":5},\"summary\":\"删除测试条目\"}"
    ],
    "api_responses": {
      "list": {
        "status": "ok",
        "data": [
          {"id": 5, "title": "测试条目", "details": null, "due_at": null, "status": "pending"}
        ]
      },
      "delete": {"status": "ok", "data": {"deleted": 1}}
    },
    "expected_action": "delete",
    "expected_summary": "删除测试条目"
  }
